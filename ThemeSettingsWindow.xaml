<Window x:Class="VaultViewer.ThemeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VaultViewer.ViewModels"
        Title="Theme Settings" Width="660" Height="600"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Opacity="{Binding WindowOpacity}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="WinCloseButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="130" />
        </Style>

        <!-- Label above a control, used when two fields sit side by side -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- Narrower row label used in the two-column colour grid -->
        <Style x:Key="ColorRowLabel" TargetType="TextBlock" BasedOn="{StaticResource RowLabel}">
            <Setter Property="Width" Value="96" />
        </Style>

        <!-- Color swatch button: shows the color as background + hex text, opens picker on click -->
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <TextBlock x:Name="lbl"
                                       Text="{Binding Hex}"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="White"
                                       Margin="10,0"
                                       VerticalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.6" />
                                </TextBlock.Effect>
                            </TextBlock>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{DynamicResource BgBrush}">
            <Grid>
                <TextBlock Text="Theme Settings" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="16,0,0,0" />
                <Button x:Name="CloseBtn" Style="{StaticResource WinCloseButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="CloseBtn_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE8BB;" />
                </Button>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="20,2,20,2">
                <StackPanel Margin="0,0,0,6">

                    <!-- ── Colors ── -->
                    <TextBlock Style="{StaticResource SectionLabel}" Text="Colors" Margin="0,2,0,4" />

                    <ItemsControl ItemsSource="{Binding ColorEntries}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ColorEntryViewModel}">
                                <Grid Margin="0,2,16,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                               Style="{StaticResource ColorRowLabel}" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource SwatchButton}"
                                            Tag="{Binding}"
                                            Click="ColorSwatch_Click"
                                            ToolTip="Click to pick a color"
                                            Background="{Binding Hex, Converter={StaticResource HexToColorBrush}}"
                                            BorderBrush="{DynamicResource BorderBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ── Typography ── -->
                    <TextBlock Style="{StaticResource SectionLabel}" Text="Typography" Margin="0,12,0,4" />

                    <!-- Font family + font size, side by side -->
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Font Family" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding AvailableFonts}"
                                      SelectedItem="{Binding SelectedFont}"
                                      Height="34"
                                      VerticalContentAlignment="Center"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="13" Foreground="Black" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Font Size" Style="{StaticResource FieldLabel}" />
                            <Grid Height="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="9" Maximum="20"
                                        SmallChange="1" LargeChange="2" TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding FontSize}"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding FontSize, StringFormat={}{0:0}pt}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="12" Margin="6,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Font preview -->
                    <Border Margin="0,10,0,0" Padding="12,8"
                            Background="{DynamicResource PanelAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock Text="The quick brown fox jumps over the lazy dog"
                                   FontFamily="{Binding SelectedFont}"
                                   FontSize="{Binding FontSize}"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- ── Window ── -->
                    <TextBlock Style="{StaticResource SectionLabel}" Text="Window" />

                    <!-- Opacity (live-previewed via Window.Opacity binding) -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Opacity" Style="{StaticResource RowLabel}" />
                        <Slider Grid.Column="1" Minimum="0.3" Maximum="1.0"
                                SmallChange="0.01" LargeChange="0.1" TickFrequency="0.05"
                                IsSnapToTickEnabled="False"
                                Value="{Binding WindowOpacity}"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding WindowOpacity, StringFormat={}{0:P0}}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="12" Margin="6,0,0,0" />
                    </Grid>

                    <!-- Where the settings file lives on disk -->
                    <StackPanel Margin="0,6,0,0">
                        <TextBlock Text="Settings file" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding SettingsFilePath, Mode=OneWay}" IsReadOnly="True"
                                 Background="{DynamicResource PanelAltBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                 FontFamily="Consolas" FontSize="11" Padding="8,5" />
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="1" Height="56"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="20,0">
                <Grid>
                    <Button Content="Restore Defaults" Height="34" MinWidth="120"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Command="{Binding RestoreDefaultsCommand}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Cancel" Height="34" MinWidth="84" Margin="0,0,8,0"
                                Command="{Binding CancelCommand}" />
                        <Button Style="{StaticResource AccentButton}" Content="Save" Height="34" MinWidth="84"
                                Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
